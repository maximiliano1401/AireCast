<Project>
  <!--
    audiocap.exe captura el audio del sistema en Windows (ver audiocap/audiocap.cs) y AudioCapture lo busca junto al
    ejecutable. Sin él la TV recibe silencio y el PC sigue sonando. Este archivo lo importan la app y la consola:
    compila audiocap.exe si falta y lo copia al ejecutar (dotnet run) y al publicar.
  -->
  <PropertyGroup>
    <AudioCapSource>$(MSBuildThisFileDirectory)audiocap\audiocap.cs</AudioCapSource>
    <AudioCapScript>$(MSBuildThisFileDirectory)audiocap\build-audiocap.ps1</AudioCapScript>
    <AudioCapExe>$(MSBuildThisFileDirectory)audiocap\build\audiocap.exe</AudioCapExe>
    <AudioCapForWindows Condition="$(RuntimeIdentifier.StartsWith('win')) Or ('$(RuntimeIdentifier)' == '' And $([MSBuild]::IsOSPlatform('Windows')))">true</AudioCapForWindows>
  </PropertyGroup>

  <!-- Solo en un Windows (usa el csc.exe de .NET Framework). Incremental: se repite si cambia audiocap.cs. -->
  <Target Name="BuildAudioCap" Inputs="$(AudioCapSource)" Outputs="$(AudioCapExe)"
          Condition="'$(AudioCapForWindows)' == 'true' And $([MSBuild]::IsOSPlatform('Windows')) And Exists('$(AudioCapScript)')">
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(AudioCapScript)&quot;" ContinueOnError="true" />
  </Target>

  <Target Name="CopyAudioCap" AfterTargets="Build" DependsOnTargets="BuildAudioCap" Condition="'$(AudioCapForWindows)' == 'true'">
    <Warning Condition="!Exists('$(AudioCapExe)')"
             Text="No se encontró $(AudioCapExe): en Windows la TV recibirá silencio. Compílalo con core\audiocap\build-audiocap.ps1." />
    <Copy Condition="Exists('$(AudioCapExe)')" SourceFiles="$(AudioCapExe)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
  </Target>

  <Target Name="PublishAudioCap" AfterTargets="Publish" Condition="'$(AudioCapForWindows)' == 'true' And Exists('$(AudioCapExe)')">
    <Copy SourceFiles="$(AudioCapExe)" DestinationFolder="$(PublishDir)" />
  </Target>
</Project>
