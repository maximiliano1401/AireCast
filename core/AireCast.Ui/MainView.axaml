<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:AireCast.Ui"
             x:Class="AireCast.Ui.MainView"
             x:DataType="ui:MainView"
             Background="#070B14"
             Foreground="{StaticResource TextPrimary}"
             FontFamily="Inter">
  <Grid RowDefinitions="Auto,*,Auto,Auto">

    <!-- Cabecera -->
    <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Margin="16,16,16,14">
      <Image Source="avares://AireCast.Ui/logo-256.png" Width="40" Height="40"
             Stretch="Uniform" VerticalAlignment="Center" />
      <StackPanel Grid.Column="1" Margin="11,0,12,0" Spacing="1" VerticalAlignment="Center">
        <TextBlock Text="AireCast" Classes="h1" />
        <TextBlock Text="Tu pantalla en la TV" Classes="hint" TextTrimming="CharacterEllipsis" />
      </StackPanel>
      <Button x:Name="ScanButton" Grid.Column="2" Classes="ghost" Content="Buscar"
              Click="OnScan" VerticalAlignment="Center" />
    </Grid>

    <!-- Contenido desplazable -->
    <ScrollViewer Grid.Row="1"
                  HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="16,0,16,4" Spacing="12">

        <!-- Televisores -->
        <Border Classes="card">
          <StackPanel Spacing="4">
            <TextBlock Text="DISPOSITIVOS" Classes="section" Margin="4,0,4,6" />
            <ListBox x:Name="DeviceList" SelectionChanged="OnDeviceSelected"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="ui:DeviceRow">
                  <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                    <Border Classes="rowIcon" Width="38" Height="38" VerticalAlignment="Center">
                      <PathIcon Width="18" Height="18" Foreground="#79A9CB"
                                Data="M21,3H3C1.9,3 1,3.9 1,5V17C1,18.1 1.9,19 3,19H10V21H7V23H17V21H14V19H21C22.1,19 23,18.1 23,17V5C23,3.9 22.1,3 21,3M21,17H3V5H21V17Z" />
                    </Border>
                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                      <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold"
                                 TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                      <TextBlock Text="{Binding Details}" Classes="meta" FontSize="11.5"
                                 TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <Border Grid.Column="2" Classes="tag" VerticalAlignment="Center"
                            IsVisible="{Binding HasState}">
                      <TextBlock Text="{Binding State}" FontSize="10" FontWeight="SemiBold"
                                 Foreground="#9FC8E6" />
                    </Border>
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <TextBlock x:Name="EmptyText" Classes="empty" TextWrapping="Wrap"
                       TextAlignment="Center" Margin="8,8" />
          </StackPanel>
        </Border>

        <!-- PIN -->
        <Border x:Name="PairPanel" Classes="card accent" IsVisible="False">
          <StackPanel Spacing="10">
            <TextBlock x:Name="PairTitle" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" />
            <TextBlock Text="Escribe el PIN de 4 dígitos que aparece en la TV." Classes="hint"
                       TextWrapping="Wrap" />
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
              <TextBox x:Name="PinBox" MaxLength="4" PlaceholderText="••••"
                       TextInputOptions.ContentType="Digits" KeyDown="OnPinKey"
                       FontSize="20" FontWeight="SemiBold" LetterSpacing="6"
                       HorizontalContentAlignment="Center" />
              <Button x:Name="PinButton" Grid.Column="1" Classes="accent" Content="Emparejar"
                      Click="OnPair" />
            </Grid>
          </StackPanel>
        </Border>

        <!-- Código en pantalla -->
        <Border x:Name="CodePanel" Classes="card accent" IsVisible="False">
          <StackPanel Spacing="10">
            <TextBlock Text="Código en pantalla" FontSize="15" FontWeight="SemiBold" />
            <TextBlock x:Name="CodeText" Classes="hint" TextWrapping="Wrap" />
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
              <TextBox x:Name="CodeBox" MaxLength="4" PlaceholderText="••••"
                       TextInputOptions.ContentType="Digits" KeyDown="OnCodeKey"
                       FontSize="20" FontWeight="SemiBold" LetterSpacing="6"
                       HorizontalContentAlignment="Center" />
              <Button Grid.Column="1" Classes="accent" Content="Conectar" Click="OnCode" />
            </Grid>
          </StackPanel>
        </Border>

        <!-- Destino y acción principal -->
        <StackPanel Spacing="10" Margin="0,2,0,2">
          <Border Classes="target">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
              <PathIcon Width="18" Height="18" Foreground="#6E8FB2" VerticalAlignment="Center"
                        Data="M21,3H3C1.9,3 1,3.9 1,5V17C1,18.1 1.9,19 3,19H10V21H7V23H17V21H14V19H21C22.1,19 23,18.1 23,17V5C23,3.9 22.1,3 21,3M21,17H3V5H21V17Z" />
              <TextBlock x:Name="TargetText" Grid.Column="1" Classes="meta"
                         Text="Elige un dispositivo" TextWrapping="NoWrap"
                         TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
            </Grid>
          </Border>

          <Button x:Name="ShareButton" Classes="primary" IsEnabled="False" Click="OnShare"
                  HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                  MinHeight="54" FontSize="15">
            <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
              <PathIcon Width="19" Height="19"
                        Data="M1,18V21H4C4,19.34 2.66,18 1,18M1,14V16C3.76,16 6,18.24 6,21H8C8,17.13 4.87,14 1,14M1,10V12C5.97,12 10,16.03 10,21H12C12,14.92 7.08,10 1,10M21,3H3C1.9,3 1,3.9 1,5V8H3V5H21V19H14V21H21C22.1,21 23,20.1 23,19V5C23,3.9 22.1,3 21,3Z" />
              <TextBlock Text="Compartir pantalla" FontWeight="SemiBold" VerticalAlignment="Center" />
            </StackPanel>
          </Button>

          <TextBlock x:Name="ShareNote" Classes="hint" TextWrapping="Wrap" />
        </StackPanel>

        <!-- Ajustes avanzados -->
        <Expander IsExpanded="False" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
          <Expander.Header>
            <StackPanel Orientation="Horizontal" Spacing="8">
              <PathIcon Width="16" Height="16" Foreground="#7E93B4" VerticalAlignment="Center"
                        Data="M3,17V19H9V17H3M3,5V7H13V5H3M13,21V19H21V17H13V15H11V21H13M7,9V11H3V13H7V15H9V9H7M21,13V11H11V13H21M15,9H17V7H21V5H17V3H15V9Z" />
              <TextBlock Text="Ajustes avanzados" FontSize="13" FontWeight="SemiBold"
                         Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" />
            </StackPanel>
          </Expander.Header>

          <Border Classes="inset" Margin="0,8,0,0">
            <StackPanel Spacing="14">
              <StackPanel Spacing="6">
                <TextBlock Text="Resolución" Classes="label" />
                <ComboBox x:Name="ResolutionBox" SelectionChanged="OnSettingChanged"
                          HorizontalAlignment="Stretch" />
                <TextBlock x:Name="ResolutionHint" Classes="hint" TextWrapping="Wrap" />
              </StackPanel>

              <StackPanel Spacing="6">
                <TextBlock Text="Fotogramas por segundo" Classes="label" TextWrapping="Wrap" />
                <ComboBox x:Name="FpsBox" SelectionChanged="OnSettingChanged"
                          HorizontalAlignment="Stretch" />
              </StackPanel>

              <StackPanel Spacing="6">
                <TextBlock Text="Red" Classes="label" />
                <ComboBox x:Name="NetworkBox" SelectionChanged="OnSettingChanged"
                          HorizontalAlignment="Stretch" />
                <TextBlock x:Name="NetworkHint" Classes="hint" TextWrapping="Wrap" />
              </StackPanel>

              <StackPanel Spacing="6">
                <TextBlock Text="Registro técnico" Classes="label" />
                <TextBox x:Name="LogBox" IsReadOnly="True" AcceptsReturn="True"
                         TextWrapping="Wrap" Height="140" FontSize="11.5"
                         Padding="12,10" VerticalContentAlignment="Top" />
              </StackPanel>
            </StackPanel>
          </Border>
        </Expander>
      </StackPanel>
    </ScrollViewer>

    <!-- En emisión -->
    <Border x:Name="NowPlaying" Grid.Row="2" Classes="live" Margin="16,10,16,0"
            IsVisible="False">
      <Grid ColumnDefinitions="3,*,Auto" ColumnSpacing="12">
        <Border Background="{StaticResource Accent}" CornerRadius="2" />
        <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <Ellipse Width="6" Height="6" Fill="{StaticResource Accent}" VerticalAlignment="Center" />
            <TextBlock Text="COMPARTIENDO PANTALLA" FontSize="9.5" FontWeight="SemiBold"
                       LetterSpacing="0.8" Foreground="#F0A276" />
          </StackPanel>
          <TextBlock x:Name="NowPlayingTarget" FontSize="14" FontWeight="SemiBold"
                     TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
        </StackPanel>
        <Button Grid.Column="2" Classes="stop" Content="Detener" Click="OnStop"
                VerticalAlignment="Center" />
      </Grid>
    </Border>

    <!-- Estado -->
    <Border Grid.Row="3" Margin="16,10,16,14" Padding="2,9,0,0"
            BorderBrush="#162337" BorderThickness="0,1,0,0">
      <TextBlock x:Name="StatusText" FontSize="12" LineHeight="17"
                 Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" />
    </Border>
  </Grid>
</UserControl>
