<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:AireCast.Ui"
             x:Class="AireCast.Ui.MainView"
             x:DataType="ui:MainView"
             Background="#070B14">
  <Grid RowDefinitions="Auto,*,Auto,Auto" Margin="16">
    <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,12">
      <StackPanel Orientation="Horizontal" Spacing="10">
        <Image Source="avares://AireCast.Ui/logo-256.png" Width="38" Height="38" />
        <StackPanel VerticalAlignment="Center">
          <TextBlock Text="AireCast" FontSize="18" FontWeight="Bold" />
          <TextBlock Text="Tu pantalla y su audio en el televisor" Classes="meta" TextTrimming="CharacterEllipsis" />
        </StackPanel>
      </StackPanel>
      <Button x:Name="ScanButton" Grid.Column="1" Content="Buscar" Click="OnScan" VerticalAlignment="Center" CornerRadius="10" />
    </Grid>

    <ScrollViewer Grid.Row="1">
      <StackPanel Spacing="10">
        <Border Classes="panel">
          <StackPanel Spacing="6">
            <TextBlock Text="DISPOSITIVOS" Classes="heading" />
            <ListBox x:Name="DeviceList" Background="Transparent" MaxHeight="230" SelectionChanged="OnDeviceSelected">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="ui:DeviceRow">
                  <Grid ColumnDefinitions="*,Auto">
                    <StackPanel>
                      <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                      <TextBlock Text="{Binding Details}" Classes="meta" />
                    </StackPanel>
                    <Border Grid.Column="1" Classes="tag" VerticalAlignment="Center" IsVisible="{Binding HasState}">
                      <TextBlock Text="{Binding State}" FontSize="10.5" Foreground="#AEC6FF" />
                    </Border>
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <TextBlock x:Name="EmptyText" Classes="meta" TextWrapping="Wrap" />
          </StackPanel>
        </Border>

        <Border x:Name="PairPanel" Classes="panel" IsVisible="False">
          <StackPanel Spacing="8">
            <TextBlock x:Name="PairTitle" FontWeight="SemiBold" />
            <TextBlock Text="Escribe el PIN de 4 dígitos que aparece en la TV." Classes="meta" />
            <Grid ColumnDefinitions="*,Auto">
              <TextBox x:Name="PinBox" MaxLength="4" PlaceholderText="••••" TextInputOptions.ContentType="Digits" KeyDown="OnPinKey" />
              <Button x:Name="PinButton" Grid.Column="1" Classes="primary" Content="Emparejar" Margin="8,0,0,0" Click="OnPair" />
            </Grid>
          </StackPanel>
        </Border>

        <Border x:Name="CodePanel" Classes="panel" IsVisible="False">
          <StackPanel Spacing="8">
            <TextBlock Text="Código en pantalla" FontWeight="SemiBold" />
            <TextBlock x:Name="CodeText" Classes="meta" TextWrapping="Wrap" />
            <Grid ColumnDefinitions="*,Auto">
              <TextBox x:Name="CodeBox" MaxLength="4" PlaceholderText="••••" TextInputOptions.ContentType="Digits" KeyDown="OnCodeKey" />
              <Button Grid.Column="1" Classes="primary" Content="Conectar" Margin="8,0,0,0" Click="OnCode" />
            </Grid>
          </StackPanel>
        </Border>

        <Border Classes="panel">
          <StackPanel Spacing="10">
            <TextBlock x:Name="TargetText" Classes="meta" Text="Elige un dispositivo" TextTrimming="CharacterEllipsis" />
            <Button x:Name="ShareButton" Classes="primary" Content="Compartir pantalla" HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center" IsEnabled="False" Click="OnShare" />
            <TextBlock x:Name="ShareNote" Classes="meta" TextWrapping="Wrap" />
          </StackPanel>
        </Border>

        <Expander Header="Ajustes avanzados" IsExpanded="False" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
          <StackPanel Spacing="10">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Text="Resolución" Classes="label" />
              <ComboBox x:Name="ResolutionBox" Grid.Column="1" MinWidth="130" SelectionChanged="OnSettingChanged" />
            </Grid>
            <TextBlock x:Name="ResolutionHint" Classes="meta" TextWrapping="Wrap" />
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Text="Fotogramas por segundo" Classes="label" TextWrapping="Wrap" />
              <ComboBox x:Name="FpsBox" Grid.Column="1" MinWidth="130" SelectionChanged="OnSettingChanged" />
            </Grid>
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Text="Red" Classes="label" />
              <ComboBox x:Name="NetworkBox" Grid.Column="1" MinWidth="130" SelectionChanged="OnSettingChanged" />
            </Grid>
            <TextBlock x:Name="NetworkHint" Classes="meta" TextWrapping="Wrap" />
            <TextBlock Text="Registro técnico" Classes="label" />
            <TextBox x:Name="LogBox" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" Height="120" FontSize="11" />
          </StackPanel>
        </Expander>
      </StackPanel>
    </ScrollViewer>

    <Border x:Name="NowPlaying" Grid.Row="2" Classes="panel" Margin="0,10,0,0" IsVisible="False">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel VerticalAlignment="Center">
          <TextBlock Text="Duplicando pantalla" FontWeight="SemiBold" />
          <TextBlock x:Name="NowPlayingTarget" Classes="meta" />
        </StackPanel>
        <Button Grid.Column="1" Classes="stop" Content="Detener" Click="OnStop" />
      </Grid>
    </Border>

    <TextBlock x:Name="StatusText" Grid.Row="3" Margin="0,10,0,0" Classes="label" TextWrapping="Wrap" />
  </Grid>
</UserControl>
