<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="AireCast.Ui.App"
             RequestedThemeVariant="Dark">
  <Application.Styles>
    <FluentTheme />

    <Style Selector="Border.panel">
      <Setter Property="Background" Value="#0DFFFFFF" />
      <Setter Property="BorderBrush" Value="#2494A3B8" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="14" />
      <Setter Property="Padding" Value="14,12" />
    </Style>
    <Style Selector="TextBlock.heading">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="LetterSpacing" Value="0.9" />
      <Setter Property="Foreground" Value="#6F7F99" />
    </Style>
    <Style Selector="TextBlock.label">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="#A2AFC6" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBlock.meta">
      <Setter Property="FontSize" Value="11.5" />
      <Setter Property="Foreground" Value="#6F7F99" />
    </Style>
    <Style Selector="Border.tag">
      <Setter Property="CornerRadius" Value="99" />
      <Setter Property="Padding" Value="8,1" />
      <Setter Property="Background" Value="#245B8CFF" />
    </Style>
    <Style Selector="Button.primary">
      <Setter Property="Background" Value="#5B8CFF" />
      <Setter Property="Foreground" Value="#FFFFFF" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="16,9" />
    </Style>
    <Style Selector="Button.stop">
      <Setter Property="Background" Value="#33FB7185" />
      <Setter Property="Foreground" Value="#FB7185" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="CornerRadius" Value="10" />
    </Style>
    <Style Selector="ListBoxItem:selected TextBlock.meta">
      <Setter Property="Foreground" Value="#C9D6F0" />
    </Style>
    <Style Selector="ListBoxItem">
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="10,8" />
      <Setter Property="Margin" Value="0,2" />
    </Style>
  </Application.Styles>
</Application>
