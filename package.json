{
  "name": "airecast",
  "productName": "AireCast",
  "version": "0.5.0",
  "description": "AireCast MVP: emisor AirPlay de escritorio",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "node launch.js",
    "build:bridge": "powershell -NoProfile -ExecutionPolicy Bypass -File build-bridge.ps1",
    "build:audiocap": "powershell -NoProfile -ExecutionPolicy Bypass -File build-audiocap.ps1",
    "dist": "npm run build:bridge && electron-builder --win"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^26.18.0"
  },
  "allowScripts": {
    "electron@33.4.11": true
  },
  "build": {
    "appId": "com.max.airecast",
    "productName": "AireCast",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "styles.css",
      "renderer.js",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "build/bridge",
        "to": "bridge"
      },
      {
        "from": "build/ffmpeg",
        "to": "ffmpeg"
      },
      {
        "from": "build/audiocap",
        "to": "audiocap"
      }
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "AireCast"
    },
    "portable": {
      "artifactName": "AireCast-${version}-portable.exe"
    }
  }
}
